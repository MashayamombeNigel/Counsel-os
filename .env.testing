APP_ENV=testing
APP_KEY=base64:FnnMTdASPxsMKe1HJvur9N6ONxU8iSuMrHFX1Jx4nSw=
APP_DEBUG=true

# Dedicated Postgres test database - matches production/CI exactly,
# per your decision to avoid SQLite masking Postgres-specific bugs
# (this schema uses native enums, which SQLite doesn't have).
# Create it once locally: createdb counselos_test
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=counselos_test
DB_USERNAME=postgres
DB_PASSWORD=admin

# sync makes ExtractDocumentTextJob/AnalyzeDocumentJob run immediately
# inline when dispatched, so Feature tests can assert final state
# without needing a running queue worker. Tests that specifically
# want to assert *dispatch* rather than execution use Queue::fake()
# to override this per-test.
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

MAIL_MAILER=array

# Never a real key - every test that touches Gemini uses Http::fake(),
# so this only needs to exist, never actually authenticate.
GEMINI_API_KEY=test-fake-key-not-real
GEMINI_MODEL=gemini-2.5-flash

SESSION_DRIVER=array
CACHE_STORE=array
